# Browser-safe configuration only. Do not put Gemini API keys in VITE_* variables.
# Local development defaults to mock when these values are omitted.
# Production defaults to the public Worker endpoint and real AI.
# VITE_USE_MOCK_ANALYSIS accepts only exact `true` or `false`; any other non-empty value disables analysis.
# VITE_API_BASE_URL=/api
# VITE_USE_MOCK_ANALYSIS=true
# VITE_ANALYSIS_TIMEOUT_MS=120000

# Worker secrets to configure with `wrangler secret put` (never commit their values):
# GEMINI_API_KEY=
# Optional. Discord/Slack incoming webhook the hourly watch alerts to when
# Gemini stops answering. Without it the watch still writes to Workers Logs.
# ALERT_WEBHOOK_URL=

# Worker non-secret configuration lives in wrangler.jsonc (the source of truth).
# In particular, read ALLOWED_ORIGIN there; never override it in the Cloudflare dashboard.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# MAX_CHARS=200000
# DAILY_BUDGET_LIMIT=100
# DAILY_TOKEN_BUDGET=2000000

# Local Worker mock configuration (copy to .dev.vars; do not add real values here):
# MOCK_ANALYSIS=true
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
